  <rect x="220" y="670" width="40" height="40" rx="8" fill="#2a9d95"/>
  <text x="260" y="710" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="#fff">ПЕРЕЙТИ НА САЙТ</text>
  <path d="M200 340 L1200 340" stroke="#2a9d95" stroke-width="1" stroke-dasharray="4 4"/>
