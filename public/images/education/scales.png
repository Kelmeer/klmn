  <text x="220" y="650" text-anchor="start" font-family="system-ui" font-size="12" font-weight="500" fill="#5d6b75">ВАШ, ЦРШ, McGill, CES-D, SF-36 и другие инструменты</text>
  <rect x="200" y="700" width="960" height="60" rx="12" fill="#fff" stroke="#2a9d95" stroke-width="1.5"/>
  <rect x="220" y="712" width="200" height="38" rx="10" fill="#2a9d95"/>
  <text x="320" y="750" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="#fff">СКАЧАТЬ ШКАЛЫ</text>
  <path d="M200 340 L1200 340" stroke="#2a9d95" stroke-width="1" stroke-dasharray="4 4"/>
