<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eef6f4"/>
      <stop offset="1" stop-color="#e0f0ec"/>
    </linearGradient>
    <linearGradient id="line" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2a9d95"/>
      <stop offset="1" stop-color="#3fb8ae"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#bg)"/>
  <rect x="0" y="0" width="1200" height="800" fill="url(#bg)" opacity="0.5"/>
  <rect x="60" y="60" width="1080" height="680" rx="20" fill="none" stroke="#e3eaed" stroke-width="1"/>
  <rect x="120" y="120" width="960" height="560" rx="16" fill="#fff" stroke="#2a9d95" stroke-width="3"/>
  <rect x="120" y="120" width="960" height="560" rx="16" fill="none" stroke="#2a9d95" stroke-width="1" opacity="0.3"/>
  <rect x="120" y="120" width="960" height="560" rx="16" fill="url(#bg)" opacity="0.2"/>
  <rect x="200" y="140" width="140" height="40" rx="10" fill="#2a9d95"/>
  <text x="270" y="170" text-anchor="middle" font-family="system-ui" font-size="15" font-weight="700" fill="#fff">ОПРОСНИКИ</text>
  <rect x="200" y="140" width="300" height="40" rx="10" fill="#fff" stroke="#2a9d95" stroke-width="1.5"/>
  <text x="350" y="170" text-anchor="middle" font-family="system-ui" font-size="15" font-weight="700" fill="#2a9d95">И ШКАЛЫ</text>
  <rect x="200" y="250" width="960" height="260" rx="16" fill="#fff" stroke="#e3eaed" stroke-width="1"/>
  <rect x="220" y="270" width="40" height="40" rx="8" fill="#2a9d95"/>
  <text x="260" y="310" text-anchor="middle" font-family="system-ui" font-size="15" font-weight="800" fill="#2a9d95">ОЦЕНКИ БОЛИ</text>
  <rect x="220" y="430" width="560" height="18" rx="4" fill="#e3eaed"/>
  <rect x="220" y="460" width="440" height="18" rx="4" fill="#e3eaed"/>
  <rect x="220" y="490" width="380" height="18" rx="4" fill="#e3eaed"/>
